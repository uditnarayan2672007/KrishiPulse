# -------------------------------------------------------------
# KrishiPulse Environment Configuration
# -------------------------------------------------------------

# Supabase Authentication (Frontend)
# Public variables exposed to Vite client
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Authentication & Database Secrets (Serverless API only)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/krishipulse?retryWrites=true&w=majority

# Hardware Authentication Secret (used for ESP32 device auth verification)
DEVICE_AUTH_SECRET=your-secure-device-pre-shared-secret

# Machine Learning Service (Python FastAPI / Flask microservice)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=your-ml-api-key
